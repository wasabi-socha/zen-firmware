#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    macros {
        jp_dquote: jp_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp AT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp AT>;
        };

        jp_amp: jp_amp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CARET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp CARET>;
        };

        jp_quote: jp_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp AMPERSAND>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp AMPERSAND>;
        };

        jp_equal: jp_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp UNDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp UNDER>;
        };

        jp_caret: jp_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp EQUAL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp EQUAL>;
        };

        jp_yen: jp_yen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp INT_YEN>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT_YEN>;
        };

        jp_plus: jp_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp COLON>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp COLON>;
        };

        jp_tilde: jp_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp PLUS>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp PLUS>;
        };

        jp_pipe: jp_pipe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT_YEN)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT_YEN)>;
        };

        jp_at: jp_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_BRACKET>;
        };

        jp_colon: jp_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp SINGLE_QUOTE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SINGLE_QUOTE>;
        };

        jp_asterisk: jp_asterisk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp DOUBLE_QUOTES>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp DOUBLE_QUOTES>;
        };

        jp_backquote: jp_backquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_BRACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_BRACE>;
        };

        jp_underscore: jp_underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT_RO)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT_RO)>;
        };

        jp_backslash: jp_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp INT_RO>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT_RO>;
        };

        jp_lbracket: jp_lbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RIGHT_BRACKET>;
        };

        jp_rbracket: jp_rbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp BACKSLASH>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp BACKSLASH>;
        };

        jp_lparen: jp_lparen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp ASTERISK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp ASTERISK>;
        };

        jp_rparen: jp_rparen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_PARENTHESIS>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_PARENTHESIS>;
        };

        jp_lbrace: jp_lbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_BRACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RIGHT_BRACE>;
        };

        jp_rbrace: jp_rbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp PIPE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp PIPE>;
        };

        jp_hanzen: jp_hanzen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GRAVE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp GRAVE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB    &kp Q         &kp W         &kp E                    &kp R  &kp T  &kp Y           &kp U           &kp I  &kp O           &kp P           &kp DELETE
&mo 5      &kp A         &kp S         &kp D                    &kp F  &kp G  &kp H           &kp J           &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LSHFT  &kp Z         &kp X         &kp C                    &kp V  &kp B  &kp LANGUAGE_1  &kp LANGUAGE_2  &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&sk LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG_ZENKAKUHANKAKU  &mo 2  &mo 1  &kp SPACE       &kp BACKSPACE   &mo 3  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &mkp LCLK  &mo 4             &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3          &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &kp LC(UP_ARROW)  &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &trans            &trans     &trans                 &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1            &kp N2             &kp N3          &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans      &kp EXCL          &kp AT             &kp HASH        &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp APOSTROPHE  &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH
&trans      &trans            &trans             &trans          &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
